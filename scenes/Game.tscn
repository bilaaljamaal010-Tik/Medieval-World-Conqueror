extends CharacterBody3D

@export var move_speed: float = 6.0
@export var max_hp: int = 30
@export var attack_damage: int = 8
@export var attack_range: float = 2.6
@export var attack_cooldown: float = 0.9

var team_id: int = 0
var unit_name: String = "Infantry"
var is_enemy: bool = false
var move_target: Vector3 = Vector3.ZERO
var attack_target: Node3D = null
var selected: bool = false
var body_mesh: MeshInstance3D
var selection_ring: MeshInstance3D
var hp: int = max_hp
var attack_timer: float = 0.0

func _ready() -> void:
    add_to_group("unit")
    body_mesh = $Body
    selection_ring = $SelectionRing
    selection_ring.visible = false
    if body_mesh != null:
        var material := StandardMaterial3D.new()
        material.albedo_color = Color(0.1, 0.7, 0.3)
        body_mesh.material_override = material

func set_team_color(color: Color) -> void:
    if body_mesh != null:
        var material := StandardMaterial3D.new()
        material.albedo_color = color
        body_mesh.material_override = material

func set_selected(value: bool) -> void:
    selected = value
    if selection_ring != null:
        selection_ring.visible = value

func move_to(world_position: Vector3) -> void:
    move_target = world_position
    attack_target = null

func set_attack_target(target: Node3D) -> void:
    attack_target = target
    move_target = Vector3.ZERO

func apply_damage(amount: int) -> void:
    hp -= amount
    if hp <= 0:
        queue_free()

func _physics_process(delta: float) -> void:
    if attack_target != null and is_instance_valid(attack_target):
        var direction := attack_target.global_position - global_position
        direction.y = 0.0
        var distance := direction.length()
        if distance <= attack_range:
            attack_timer -= delta
            if attack_timer <= 0.0:
                attack_target.apply_damage(attack_damage)
                attack_timer = attack_cooldown
            velocity = Vector3.ZERO
            move_and_slide()
            return

    if move_target != Vector3.ZERO:
        var direction := move_target - global_position
        direction.y = 0.0
        if direction.length() > 0.25:
            velocity = direction.normalized() * move_speed
            move_and_slide()
        else:
            velocity = Vector3.ZERO
            move_target = Vector3.ZERO
    else:
        velocity = Vector3.ZERO

func _process(delta: float) -> void:
    if selected and selection_ring != null:
        selection_ring.rotation_degrees.x = 90.0
    if attack_timer > 0.0:
        attack_timer = max(0.0, attack_timer - delta)
